{
  "name": "plantdex-website",
  "version": "0.2.0",
  "private": true,
  "description": "Plantdex — storefront and Herbdex companion app for the Plantdex herbalism card deck.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:deck": "python3 scripts/build_deck.py",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
