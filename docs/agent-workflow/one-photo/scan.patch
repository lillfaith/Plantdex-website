diff --git a/src/lib/scan-one-photo.test.ts b/src/lib/scan-one-photo.test.ts
new file mode 100644
index 00000000..f2c40c11
--- /dev/null
+++ b/src/lib/scan-one-photo.test.ts
@@ -0,0 +1,46 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+/**
+ * OWNER DECISION 2026-11-26: ONE mandatory in-app camera photograph for a COLLECT observation, extra angles
+ * optional; a LOOKUP (imported photos) keeps the existing two. No mandatory capture delay.
+ */
+const invoke = vi.hoisted(() => vi.fn());
+vi.mock('./supabase-client', () => ({ supabase: { functions: { invoke } } }));
+vi.mock('./image-prepare', () => ({
+  IDENTIFY_PROFILE: {},
+  UnprocessableImageError: class extends Error {},
+  prepareImage: async () => ({ blob: new Blob(['x']), extension: 'jpg', contentType: 'image/jpeg' }),
+}));
+import { identifyPlant, isScanFailure, MIN_CAPTURE_PHOTOS, MIN_OBSERVATION_PHOTOS, type ObservationPhoto } from './scans';
+import { CAPTURE_CONFIG } from './observation-capture-receipt';
+
+const one: ObservationPhoto[] = [{ file: new File(['a'], 'a.jpg', { type: 'image/jpeg' }), organ: 'habit' }];
+
+describe('one photograph to collect', () => {
+  beforeEach(() => {
+    invoke.mockReset();
+    invoke.mockResolvedValue({ data: { candidates: [{ scientificName: 'Taraxacum officinale', score: 0.9 }] }, error: null });
+  });
+  it('the constants say one to collect and two for a lookup, and match the server contract', () => {
+    expect(MIN_CAPTURE_PHOTOS).toBe(1);
+    expect(MIN_OBSERVATION_PHOTOS).toBe(2);
+    expect(CAPTURE_CONFIG.minImages).toBe(MIN_CAPTURE_PHOTOS);
+    expect(CAPTURE_CONFIG.minCaptureMs).toBe(0);
+  });
+  it('a collect observation with ONE photograph is sent', async () => {
+    const answer = await identifyPlant(one, undefined, { capture: { sessionId: 'sid', nonce: 'n' } });
+    expect(isScanFailure(answer)).toBe(false);
+    expect(invoke).toHaveBeenCalledTimes(1);
+  });
+  it('a lookup with ONE photograph is still refused before anything is sent (existing rule)', async () => {
+    const answer = await identifyPlant(one);
+    expect(isScanFailure(answer)).toBe(true);
+    expect(invoke).not.toHaveBeenCalled();
+  });
+  it('three photographs remain the maximum for a collect', async () => {
+    const four = Array.from({ length: 4 }, (_, i) => ({ file: new File([String(i)], `${i}.jpg`, { type: 'image/jpeg' }), organ: 'habit' as const }));
+    const answer = await identifyPlant(four, undefined, { capture: { sessionId: 's', nonce: 'n' } });
+    expect(isScanFailure(answer)).toBe(true);
+    expect(invoke).not.toHaveBeenCalled();
+  });
+});
